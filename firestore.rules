rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: uid, email, role, displayName
    //
    // Collection: history
    // Fields: studentUid, studentEmail, chemicals, result, timestamp
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
         (request.auth.token.email == "phamngocsonsp@gmail.com" && request.auth.token.email_verified == true));
    }

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
